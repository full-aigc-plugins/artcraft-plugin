{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/full-aigc-plugins/artcraft-plugin/schemas/craft-task-v1.json",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "craft-task/v1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "assetId",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "expectedRevision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      ]
    },
    "runtimeIdentity": {
      "type": "object",
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "pluginVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cliVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mode": {
          "enum": [
            "headless",
            "bridge"
          ]
        },
        "capabilitySnapshotSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "pluginId",
        "pluginVersion",
        "cliVersion",
        "sha256",
        "mode",
        "capabilitySnapshotSha256"
      ],
      "additionalProperties": false
    },
    "authorizationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "budget": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "maxMinorUnits": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "maxRevisions": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "maxExternalCalls": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        }
      },
      "required": [
        "currency",
        "maxMinorUnits",
        "maxRevisions",
        "maxExternalCalls"
      ],
      "additionalProperties": false
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "schemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "protocolVersion",
    "taskId",
    "idempotencyKey",
    "planHash",
    "inputRefs",
    "expectedRevision",
    "runtimeIdentity",
    "authorizationRef",
    "budget",
    "deadline",
    "payload"
  ],
  "additionalProperties": false
}

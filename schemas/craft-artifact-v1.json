{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/full-aigc-plugins/artcraft-plugin/schemas/craft-artifact-v1.json",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "craft-artifact/v1"
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "producerTaskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "assetId",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "nativeProjectRef": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "location": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "assetId",
            "version",
            "sha256",
            "location"
          ],
          "additionalProperties": false
        }
      ]
    },
    "renditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "assetId",
          "version",
          "sha256",
          "location"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetRef": {
            "type": "object",
            "properties": {
              "assetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "assetId",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          },
          "kind": {
            "enum": [
              "media",
              "font",
              "lut"
            ]
          },
          "packaged": {
            "type": "boolean"
          },
          "missingReason": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            ]
          }
        },
        "required": [
          "assetRef",
          "kind",
          "packaged",
          "missingReason"
        ],
        "additionalProperties": false
      }
    },
    "technicalMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationTicks": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "timeBase": {
          "type": "object",
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "den": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "num",
            "den"
          ],
          "additionalProperties": false
        },
        "frameRate": {
          "type": "object",
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "den": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "num",
            "den"
          ],
          "additionalProperties": false
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "colorSpace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bitDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "alpha": {
          "type": "boolean"
        },
        "audio": {
          "type": "object",
          "properties": {
            "sampleRate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "channels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "sampleRate",
            "channels"
          ],
          "additionalProperties": false
        }
      }
    },
    "lossReportRef": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "location": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "assetId",
            "version",
            "sha256",
            "location"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "assetId",
          "version",
          "sha256",
          "location"
        ],
        "additionalProperties": false
      }
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "protocolVersion",
    "assetId",
    "version",
    "sha256",
    "bytes",
    "mediaType",
    "producerTaskId",
    "sourceRefs",
    "nativeProjectRef",
    "renditions",
    "dependencies",
    "technicalMetadata",
    "lossReportRef",
    "evidenceRefs",
    "location"
  ],
  "additionalProperties": false
}
